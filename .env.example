# Gemini. Falls back to ../.env if unset here. Search grounding (the "current angle") needs a key
# with billing enabled -- the free tier's search and daily quotas run out quickly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Telegram: create a bot with @BotFather, add it as an ADMIN of Meera's private channel.
TELEGRAM_BOT_TOKEN=
# Optional: only read posts from this channel id, e.g. -1001234567890
TELEGRAM_CHANNEL_ID=
# Optional: Meera's own chat id (gets "drafts ready" nudges). Blank = whoever sends /start first.
TELEGRAM_NOTIFY_CHAT_ID=

POSTS_PER_WEEK=3
CONTENT_DESK_PORT=5003
CONTENT_DESK_URL=http://localhost:5003
